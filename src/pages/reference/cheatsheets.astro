---
import BaseLayout from '../../layouts/BaseLayout.astro';
import CourseSidebar from '../../components/CourseSidebar.astro';
---

<BaseLayout title="Cheatsheets" sidebar>
  <CourseSidebar slot="sidebar" active="ref-cheatsheets" />

  <h1>Cheatsheets — One-Page Quick Reference</h1>
  <p>Quick-reference cards for use during practice. Print them out and post them at your practice spot for convenience.</p>

  <h2>Overall Practice Flow</h2>
  <div class="cheatsheet">
    <h4>🔄 Complete Practice Sequence</h4>
    <dl>
      <dt>1. Warm-up</dt><dd>5 minutes: Knee rotations → Dry-land swimming → Hands lifting the sky → Left-right drawing the bow</dd>
      <dt>2. Zhan Zhuang</dt><dd>10–20 minutes: Choose the posture for your current stage</dd>
      <dt>3. Cool-down</dt><dd>3 minutes: Guided pressing down / hip rotations</dd>
      <dt>Total Duration</dt><dd>18–28 minutes</dd>
    </dl>
  </div>

  <h2>Wu Chi</h2>
  <div class="cheatsheet">
    <h4>🧍 Wu Chi — Position 1</h4>
    <dl>
      <dt>Feet</dt><dd>Shoulder-width, toes pointing forward</dd>
      <dt>Knees</dt><dd>Slightly bent, not past toes</dd>
      <dt>Body</dt><dd>Spine straight, sitting-not-sitting</dd>
      <dt>Arms</dt><dd>Hanging naturally at sides, armpit balloons</dd>
      <dt>Head</dt><dd>Head suspended, gaze forward</dd>
      <dt>Breathing</dt><dd>Inhale and exhale through the nose; natural and silent</dd>
      <dt>Duration</dt><dd>3 → 20 minutes</dd>
    </dl>
  </div>

  <h2>Holding the Balloon</h2>
  <div class="cheatsheet">
    <h4>🫂 Holding the Balloon — Position 2</h4>
    <dl>
      <dt>Hand Position</dt><dd>Heart height, embracing a balloon</dd>
      <dt>Spacing</dt><dd>Not squeezing the balloon or letting it drop</dd>
      <dt>Arm Shape</dt><dd>Rounded arc, not straightened</dd>
      <dt>Fingers</dt><dd>Slightly spread, as if pressing into marble</dd>
      <dt>Mental Focus</dt><dd>Armpit balloons + balloon chair + head suspended</dd>
      <dt>Duration</dt><dd>3 → 20 minutes</dd>
    </dl>
  </div>

  <h2>Holding in Front</h2>
  <div class="cheatsheet">
    <h4>👐 Holding in Front — Position 3</h4>
    <dl>
      <dt>Hand Position</dt><dd>Extended forward, shoulder height, palms down</dd>
      <dt>Imagery</dt><dd>Pressing down on balloons floating on water</dd>
      <dt>Mental Focus</dt><dd>Keep smiling</dd>
      <dt>Weight Distribution</dt><dd>Neither leaning forward nor backward</dd>
      <dt>Cool-down</dt><dd>Guided pressing down</dd>
    </dl>
  </div>

  <h2>Splitting Water</h2>
  <div class="cheatsheet">
    <h4>🌊 Splitting Water — Position 4</h4>
    <dl>
      <dt>Hand Position</dt><dd>Both sides, slightly below shoulder height, palms down</dd>
      <dt>Imagery</dt><dd>Both hands pressing on floating balls at the water's surface</dd>
      <dt>Position</dt><dd>Neither forward nor backward — naturally at the sides</dd>
      <dt>Cool-down</dt><dd>Guided pressing down</dd>
    </dl>
  </div>

  <h2>Holding at Dantian</h2>
  <div class="cheatsheet">
    <h4>🧘 Holding at Dantian — Position 5</h4>
    <dl>
      <dt>Hand Position</dt><dd>Embracing a ball in front of the Dantian (lower abdomen)</dd>
      <dt>Force</dt><dd>Not crushing, not dropping</dd>
      <dt>Ultimate Practice</dt><dd>Five-posture flow — 5 minutes each</dd>
      <dt>Cool-down</dt><dd>Guided pressing down</dd>
    </dl>
  </div>

  <h2>Error Correction</h2>
  <div class="cheatsheet">
    <h4>❌ Common Errors → ✅ Corrections</h4>
    <dl>
      <dt>Knees past toes</dt><dd>Bend only slightly</dd>
      <dt>Chest or abdomen pushed out</dt><dd>Relax; sitting-not-sitting</dd>
      <dt>Buttocks sticking out</dt><dd>Center the tailbone; balloon chair</dd>
      <dt>Hunched shoulders</dt><dd>Sink shoulders, drop elbows; armpit balloons</dd>
      <dt>Arms flat against body</dt><dd>Hold armpit balloons for slight opening</dd>
      <dt>Holding the breath</dt><dd>Inhale and exhale through the nose; natural</dd>
      <dt>Dizziness / overheating</dt><dd>Stop immediately!</dd>
    </dl>
  </div>
</BaseLayout>