---
import BaseLayout from '../../layouts/BaseLayout.astro';
import CourseSidebar from '../../components/CourseSidebar.astro';
---

<BaseLayout title="Reference Area" sidebar>
  <CourseSidebar slot="sidebar" active="ref-postures" />

  <h1>Reference Area</h1>
  <p>Quick-reference tools: Posture Library, Cheatsheets, Mind Maps, FAQ, and Glossary.</p>

  <div class="card-grid">
    <a href="reference/postures" class="card" style="text-decoration:none;color:inherit">
      <h3>🧍 Posture Library</h3><p>Quick-reference cards for 5 postures</p>
    </a>
    <a href="reference/cheatsheets" class="card" style="text-decoration:none;color:inherit">
      <h3>📋 Cheatsheets</h3><p>One-page quick summaries</p>
    </a>
    <a href="reference/mindmaps" class="card" style="text-decoration:none;color:inherit">
      <h3>🗺️ Mind Maps</h3><p>Posture relationships, intent system, philosophical lineage</p>
    </a>
    <a href="reference/faq" class="card" style="text-decoration:none;color:inherit">
      <h3>❓ FAQ</h3><p>Common questions and body responses</p>
    </a>
    <a href="reference/glossary" class="card" style="text-decoration:none;color:inherit">
      <h3>📖 Glossary</h3><p>English–Chinese terminology reference</p>
    </a>
  </div>
</BaseLayout>