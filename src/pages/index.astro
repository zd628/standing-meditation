---
import BaseLayout from '../layouts/BaseLayout.astro';
import VideoEmbed from '../components/VideoEmbed.astro';

const postures = [
  { num: 1, name: 'Wu Chi', cn: '无极桩', desc: 'The starting point of all postures. Feet shoulder-width, arms hanging naturally, standing like a tree.', href: '/postures/wu-chi', level: 'Beginner' },
  { num: 2, name: 'Holding the Balloon', cn: '抱圆桩', desc: 'Arms at heart height, embracing as if holding a large balloon. The most classic health posture.', href: '/postures/holding-balloon', level: 'Beginner' },
  { num: 3, name: 'Holding in Front', cn: '扶按桩', desc: 'Arms extended forward, palms down, as if pressing on floating balls.', href: '/postures/holding-front', level: 'Intermediate' },
  { num: 4, name: 'Splitting Water', cn: '分水桩', desc: 'Arms at your sides, palms down, as if parting water.', href: '/postures/splitting-water', level: 'Intermediate' },
  { num: 5, name: 'Holding at Dantian', cn: '抱丹田桩', desc: 'Arms cradling a ball at the lower abdomen (Dantian), nourishing internal energy.', href: '/postures/holding-dantian', level: 'Advanced' },
];
---

<BaseLayout title="Standing Meditation — Home">
  <div class="hero">
    <h1>🌳 Standing Meditation</h1>
    <p class="subtitle">Stand like a tree — grow strength in stillness</p>
  </div>

  <div class="callout">
    <h4>What is this?</h4>
    <p>This is a personal study and practice website for <strong>Zhan Zhuang (站桩)</strong> — Chinese standing meditation.
    It is based on the system of <strong>Master Lam Kam-Chuen</strong>, integrating his book <em>The Way of Energy</em>
    with the Channel 4 documentary series <em>Stand Still Be Fit</em>. Zhan Zhuang is a traditional Chinese Qigong
    practice that is externally still but internally active — standing like a tree, cultivating internal energy (chi)
    through specific postures, breathing, and mental focus.</p>
  </div>

  <h2>Course Map: Five Postures Progression</h2>
  <p>Master Lam's system contains 5 core standing postures, progressing from simple to complex.
  Each posture builds upon the previous one. It is recommended to comfortably hold each posture for 20 minutes
  before moving to the next.</p>

  <div class="course-map">
    {postures.map((p, i) => (
      <>
        <a href={p.href} class="map-item" style="text-decoration: none; color: inherit;">
          <div class="map-num">{p.num}</div>
          <div>
            <h3 style="margin: 0; font-size: 1.1rem;">
              {p.name} <span style="color: var(--color-text-muted); font-weight: normal; font-size: 0.9rem;">{p.cn}</span>
              <span class={`tag tag-${p.level === 'Beginner' ? 'beginner' : p.level === 'Intermediate' ? 'intermediate' : 'advanced'}`}>{p.level}</span>
            </h3>
            <p style="margin: 0.3rem 0 0; font-size: 0.9rem; color: var(--color-text-muted);">{p.desc}</p>
          </div>
        </a>
        {i < postures.length - 1 && <div class="map-line"></div>}
      </>
    ))}
  </div>

  <h2>Quick Start</h2>
  <div class="card-grid">
    <a href="/course/beginner/intro" class="card" style="text-decoration: none; color: inherit;">
      <h3>📖 Start Here</h3>
      <p class="card-meta">Beginner · Zhan Zhuang Basics</p>
      <p>Learn what Zhan Zhuang is, why to practice, and how to begin. No experience needed.</p>
    </a>
    <a href="/course/beginner/warmups" class="card" style="text-decoration: none; color: inherit;">
      <h3>🔥 Warm-up Library</h3>
      <p class="card-meta">Beginner · Preparation</p>
      <p>Illustrated guide to all warm-up and cool-down exercises.</p>
    </a>
    <a href="/postures/wu-chi" class="card" style="text-decoration: none; color: inherit;">
      <h3>🧍 First Posture: Wu Chi</h3>
      <p class="card-meta">Position 1 · Beginner</p>
      <p>The foundation of all standing meditation. Book Ch.1-3 + BBC Day 1-2.</p>
    </a>
    <a href="/reference/cheatsheets" class="card" style="text-decoration: none; color: inherit;">
      <h3>📋 Cheatsheets</h3>
      <p class="card-meta">Reference · Quick Reference</p>
      <p>One-page quick reference cards for each posture.</p>
    </a>
  </div>

  <h2>Master Lam Kam-Chuen & the Zhan Zhuang System</h2>
  <p><strong>Master Lam Kam-Chuen</strong> began studying Chinese internal arts at age 12 under masters in Hong Kong,
  Taiwan, and mainland China. He was the first author to publish a Qigong book in the West — <em>The Way of Energy</em>
  is widely regarded as the classic introduction to standing meditation. His teacher, <strong>Professor Yu Yong Nian</strong>,
  was a leading authority on Zhan Zhuang for health and appears in the documentary series explaining its medical benefits.</p>

  <p>In 1995, Channel 4 produced a 10-part television series <em>Stand Still Be Fit</em>, in which Master Lam teaches
  the complete system day by day — from Wu Chi to Holding at Dantian. Here is Episode 1:</p>

  <VideoEmbed videoId="y07FauHYlmg" title="Stand Still Be Fit - Day 1" />

  <h2>Content Sources</h2>
  <table>
    <tr><th>Source</th><th>Type</th><th>Use</th></tr>
    <tr><td><em>The Way of Energy</em> — Master Lam Kam-Chuen</td><td>Book (166 pages, 4 parts, 10 chapters)</td><td>Systematic curriculum, theory</td></tr>
    <tr><td><em>Stand Still Be Fit</em> — Channel 4</td><td>TV series (10 episodes)</td><td>Practical demonstration, video learning</td></tr>
  </table>

  <div class="callout callout-warn">
    <h4>⚠️ Safety Notice</h4>
    <p>Although Zhan Zhuang is low-impact, it is not entirely risk-free. Static postures may cause dizziness,
    blood pressure changes, or musculoskeletal discomfort — especially for those with cardiovascular conditions
    or joint problems. If you feel dizzy or overheated, stop immediately. This site is for personal study reference
    only and does not replace medical advice.</p>
  </div>

  <div class="callout">
    <h4>📋 Copyright & Disclaimer</h4>
    <p style="font-size: 0.85rem;">This is an unofficial, non-commercial educational project. All written content is original study notes and commentary.
    Book and video titles are referenced for educational purposes under fair use. YouTube videos are embedded via YouTube's iframe API.
    <em>The Way of Energy</em> is copyrighted by Master Lam Kam-Chuen. <em>Stand Still Be Fit</em> is copyrighted by Channel 4.
    This project is not affiliated with or endorsed by Master Lam Kam-Chuen or Channel 4.</p>
  </div>
</BaseLayout>