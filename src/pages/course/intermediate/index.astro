---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import CourseSidebar from '../../../components/CourseSidebar.astro';
---

<BaseLayout title="Intermediate Course" sidebar>
  <CourseSidebar slot="sidebar" active="holding-front" />
  <h1>Intermediate Course</h1>
  <p>The Intermediate Course corresponds to BBC Days 5-8, covering the two intermediate postures: Holding in Front and Splitting Water.</p>
  <div class="card-grid">
    <a href="/postures/holding-front" class="card" style="text-decoration:none;color:inherit"><h3>👐 Holding in Front</h3><p>Position 3 · Palms down pressing on floating balls</p></a>
    <a href="/postures/splitting-water" class="card" style="text-decoration:none;color:inherit"><h3>🌊 Splitting Water</h3><p>Position 4 · Arms at the sides like parting water</p></a>
    <a href="/course/intermediate/mindmap" class="card" style="text-decoration:none;color:inherit"><h3>🗺️ Mind Maps</h3><p>Relationships of the 5 postures and progression path</p></a>
    <a href="/course/intermediate/plan" class="card" style="text-decoration:none;color:inherit"><h3>📋 Practice Plan</h3><p>Intermediate stage practice schedule</p></a>
  </div>
</BaseLayout>