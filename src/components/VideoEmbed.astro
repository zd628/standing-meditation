---
interface Props {
  videoId: string;
  title: string;
  start?: number;
}

const { videoId, title, start } = Astro.props;
const embedUrl = start
  ? `https://www.youtube.com/embed/${videoId}?start=${start}`
  : `https://www.youtube.com/embed/${videoId}`;
---

<div class="video-embed">
  <iframe
    src={embedUrl}
    title={title}
    frameborder="0"
    allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
    allowfullscreen
  ></iframe>
</div>
<p style="text-align: center; font-size: 0.85rem; color: var(--color-text-muted); margin-top: -0.5rem;">
  <a href={`https://www.youtube.com/watch?v=${videoId}${start ? `&t=${start}s` : ''}`} target="_blank" rel="noopener">Open on YouTube ↗</a>
</p>